# Neon Postgres. Use the pooled (-pooler) host for the app.
# NOTE: do not wrap in quotes; dotenv reads the raw value to end of line.
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require

# Groww Trade API -- MARKET DATA ONLY.
# This app never calls holdings, positions, orders or margin endpoints.
GROWW_API_KEY=
GROWW_SECRET=

# Indian Stock API (https://stock.indianapi.in), sent as the x-api-key header.
INDIAN_API_KEY=

# Self-imposed ceiling on Indian API calls per day. The vendor publishes no
# quota headers, so we account for calls ourselves and stop before the cap.
INDIAN_API_DAILY_BUDGET=400

ENVIRONMENT=development
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173
